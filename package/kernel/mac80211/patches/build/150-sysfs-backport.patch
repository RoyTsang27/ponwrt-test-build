Subject: [PATCH] backports: handle the stable sysfs namespace callback

Linux 6.18.65 backports kernfs commit e3b2cf6e5dba, which changes
class.namespace to return const struct ns_common * and expects the
namespace tag to point to the ns member of the network namespace.
Use the same callback as Linux 7.0 on the affected 6.18 releases.

--- a/net/wireless/sysfs.c
+++ b/net/wireless/sysfs.c
@@ -160,12 +160,22 @@ static SIMPLE_DEV_PM_OPS(wiphy_pm_ops, w
 #define WIPHY_PM_OPS NULL
 #endif
 
+#if LINUX_VERSION_IS_GEQ(7,0,0) || \
+    LINUX_VERSION_IN_RANGE(6,18,65, 6,19,0)
 static const struct ns_common *wiphy_namespace(const struct device *d)
 {
 	struct wiphy *wiphy = container_of(d, struct wiphy, dev);
 
 	return to_ns_common(wiphy_net(wiphy));
 }
+#else
+static const void *wiphy_namespace(const struct device *d)
+{
+	struct wiphy *wiphy = container_of(d, struct wiphy, dev);
+
+	return wiphy_net(wiphy);
+}
+#endif
 
 struct class ieee80211_class = {
 	.name = "ieee80211",
